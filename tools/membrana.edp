// Mesh
real theta = 4.*pi/3.;
real a = 2., b = 1.; // Half the length of the major and minor axis
border Gamma1(t=0, theta)    {x=a*cos(t); y=b*sin(t); label=0;} 
border Gamma2(t=theta, 2*pi) {x=a*cos(t); y=b*sin(t);label=1;}
mesh Th = buildmesh(Gamma1(100) + Gamma2(50));
plot(Th);
savemesh(Th,"membrana.msh");
