// mesh
border aa(t=0, 2*pi){x=5*cos(t); y=5*sin(t); label=0;};
border bb(t=0, 2*pi){x=cos(t); y=sin(t); label = 1;};
border cc(t=0, 2*pi){x=-3+cos(t); y=sin(t); label=2;};
border dd(t=0, 2*pi){x=cos(t); y =-3+sin(t); label=3;};

mesh th = buildmesh(aa(70) + bb(35) + cc(35) + dd(35));
plot(th);
savemesh(th,"discos.msh");

